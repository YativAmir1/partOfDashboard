# ─── CityMind AI · LLM provider configuration ────────────────────────────────
# All keys are SERVER-SIDE ONLY and must never be exposed to the browser.
# Copy this file to `.env.local` and fill in the key for the provider you want.
# If the selected provider has no key, the app runs in FALLBACK mode
# (high-quality static Hebrew demo text) — the demo never breaks.
#
# The LLM only explains / phrases operational recommendations. It never decides
# the recommended action. The provider is modular: for the demo we use Groq/Qwen
# or Gemini; in production it can be swapped for a private/local model running in
# the municipality's controlled environment (נימבוס / AWS Bedrock).

# Which provider drives the live LLM path: groq | anthropic | gemini | xai
LLM_PROVIDER=gemini

# ── Groq (demo provider). OpenAI-compatible API (api.groq.com). ──
# NOTE: Groq (gsk_ keys) is NOT the same as xAI/Grok (xai- keys, api.x.ai) below.
# Default is an OPEN-WEIGHT, non-reasoning model (Llama 3.3 70B) so the same
# weights can later run locally/on-prem; today we reach them via API. Avoid Qwen3
# reasoning models here — they emit <think> and mix foreign tokens into Hebrew.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── xAI (Grok). OpenAI-compatible API (api.x.ai). Requires account credits. ──
XAI_API_KEY=
XAI_MODEL=grok-3

# ── Anthropic (excellent Hebrew; production target via AWS Bedrock / Nimbus). ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Google Gemini (free tier — suggested live default for the demo). ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
